NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL="postgresql://user@localhost:5432/mal3ab_dev?schema=public"

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=10

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# --- OTP delivery: console | twilio (add a real provider under src/modules/sms when ready) ---
OTP_PROVIDER=console
OTP_TTL_SECONDS=300

# --- Storage: local | s3 ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PUBLIC_BASE=/uploads
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@mal3ab.app

# --- QR signing (generate with: openssl rand -hex 32) ---
QR_SIGNING_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:4200
