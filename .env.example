NODE_ENV=development
PORT=3000

# --- Database (add ?connection_limit=20 for production pooling) ---
DATABASE_URL="postgresql://user@localhost:5432/matchena_dev?schema=public"

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=10

# --- OAuth (leave empty to hide that provider on the login page) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Passkeys / Face ID / fingerprint (WebAuthn) ---
# localhost over HTTP is allowed. Production must match the site hostname.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Matchena
WEBAUTHN_ORIGINS=http://localhost:4200

# --- OTP delivery: console | twilio_verify ---
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Storage: local | s3 ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PUBLIC_BASE=/uploads
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@matchena.com
MAIL_REPLY_TO=support@matchena.com

# --- QR signing (generate with: openssl rand -hex 32) ---
QR_SIGNING_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:4200

# --- SEO discovery / IndexNow ---
SITE_URL=https://matchena.com
# Generate a key with: openssl rand -hex 16
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# --- Push (optional). Empty = in-app + socket only ---
FCM_SERVER_KEY=
# Native push (Android + iOS): Firebase service-account JSON, raw or base64
FIREBASE_SERVICE_ACCOUNT=
# Sign in with Apple audiences (bundle IDs), comma separated
APPLE_CLIENT_IDS=com.matchena.app

# Lobby Morphs: `true` enables the feature (unset = off, app behaves as before).
LOBBY_MORPHS_ENABLED=
# Free morph rolls per Cairo day. Leave empty for unlimited.
MORPH_DAILY_FREE_ROLLS=

# Lobby World: `true` enables movement in the squad lobby (unset = off, lobby behaves as before).
LOBBY_MOVEMENT_ENABLED=
# Lobby World: `true` adds the lobby ball; only takes effect while LOBBY_MOVEMENT_ENABLED=true.
LOBBY_BALL_ENABLED=
# Booking kiosk: `true` enables it. Independent of movement (unset = off, lobby unchanged).
LOBBY_KIOSK_ENABLED=

# --- Web Push / VAPID (optional). Empty = the "enable notifications" button never shows.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- WebRTC ICE (squad voice). STUN is public; TURN needed behind strict NAT ---
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Matchena gaming expansion — mock PSP renewal webhook shared secret (§7.6 TODO: replace with real PSP signature verification)
MEMBERSHIP_WEBHOOK_SECRET=

# --- AI (owner assistant + Captain) -------------------------------------------------------------
# OpenRouter is the main route: one key, Gemini + DeepSeek behind it, prepaid (the credit is the hard cap).
# Create a key per environment (matchena-prod / matchena-local) and give each a monthly credit limit.
# With neither key set the assistants fall back to the deterministic keyword parser.
OPENROUTER_API_KEY=
# Optional: a direct Google key as an extra route behind OpenRouter (free tier: ~20 requests/day).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional overrides — defaults are in modules/ai/ai-provider.service.ts. The owner list stays on Google models
# because owner prompts carry customer names and amounts.
# AI_OWNER_MODELS=google/gemini-3.8-flash,google/gemini-3.6-flash,google/gemini-3.5-flash
# AI_PUBLIC_MODELS=google/gemini-3.8-flash,google/gemini-3.6-flash,deepseek/deepseek-v4.1-flash
# AI_OWNER_REASONING=low
# AI_PUBLIC_REASONING=minimal
# AI_OWNER_DAILY_BUDGET_USD=1.5
# AI_PUBLIC_DAILY_BUDGET_USD=1.5
# CAPTAIN_GUEST_PER_DAY=15
# CAPTAIN_USER_PER_DAY=150
# The limits and budgets above can also be edited live in the admin AI tab (Limits); a value saved there wins.
# One-way salt for the hashes stored instead of addresses/device ids. Optional: defaults to JWT_ACCESS_SECRET.
# AI_HASH_SALT=

# --- Cloudflare Turnstile (silent bot check shown only to suspicious Captain visitors) ---
# Leave empty and nothing changes for anyone. Create a widget in the Cloudflare dashboard (Turnstile → Add site),
# put the SECRET here (Coolify), and the SITE key in the Angular environment (turnstileSiteKey).
TURNSTILE_SECRET_KEY=

# TEST ONLY — set to "openrouter" or "gemini" to simulate that route failing
# and force the next one for manual testing. Leave unset always in
# production; never enable via a deployed .env.
# AI_FORCE_FAILURE=gemini
