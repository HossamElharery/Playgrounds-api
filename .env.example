NODE_ENV=development
PORT=3000

# --- Database (add ?connection_limit=20 for production pooling) ---
DATABASE_URL="postgresql://user@localhost:5432/matchena_dev?schema=public"

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=10

# --- OAuth (leave empty to hide that provider on the login page) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Passkeys / Face ID / fingerprint (WebAuthn) ---
# localhost over HTTP is allowed. Production must match the site hostname.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Matchena
WEBAUTHN_ORIGINS=http://localhost:4200

# --- OTP delivery: console | twilio_verify ---
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Storage: local | s3 ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PUBLIC_BASE=/uploads
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@matchena.com
MAIL_REPLY_TO=support@matchena.com

# --- QR signing (generate with: openssl rand -hex 32) ---
QR_SIGNING_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:4200

# --- SEO discovery / IndexNow ---
SITE_URL=https://matchena.com
# Generate a key with: openssl rand -hex 16
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# --- Push (optional). Empty = in-app + socket only ---
FCM_SERVER_KEY=
# Native push (Android + iOS): Firebase service-account JSON, raw or base64
FIREBASE_SERVICE_ACCOUNT=
# Sign in with Apple audiences (bundle IDs), comma separated
APPLE_CLIENT_IDS=com.matchena.app

# Lobby Morphs: `true` enables the feature (unset = off, app behaves as before).
LOBBY_MORPHS_ENABLED=
# Free morph rolls per Cairo day. Leave empty for unlimited.
MORPH_DAILY_FREE_ROLLS=

# Lobby World: `true` enables movement in the squad lobby (unset = off, lobby behaves as before).
LOBBY_MOVEMENT_ENABLED=
# Lobby World: `true` adds the lobby ball; only takes effect while LOBBY_MOVEMENT_ENABLED=true.
LOBBY_BALL_ENABLED=

# --- Web Push / VAPID (optional). Empty = the "enable notifications" button never shows.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- WebRTC ICE (squad voice). STUN is public; TURN needed behind strict NAT ---
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Matchena gaming expansion — mock PSP renewal webhook shared secret (§7.6 TODO: replace with real PSP signature verification)
MEMBERSHIP_WEBHOOK_SECRET=

# --- Gemini (owner schedule voice/chat assistant — NLU only; leave empty to disable, deterministic parser is used instead) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- OpenRouter (free-tier fallback when Gemini is down/rate-limited — see ai-provider.service.ts) ---
OPENROUTER_API_KEY=

# TEST ONLY — set to "gemini" to simulate a Gemini failure and force the
# OpenRouter fallback path for manual testing. Leave unset always in
# production; never enable via a deployed .env.
# AI_FORCE_FAILURE=gemini
