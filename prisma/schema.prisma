enum AssistantSender {
  owner
  assistant
  /// Non-conversational bookkeeping row (e.g. a manual tap-to-block on the
  /// board) that only exists to anchor an undo token — never rendered as a
  /// chat bubble on the owner side, but visible to admin oversight.
  system
}

/// One line of the owner-facing "schedule assistant" chat (see
/// ScheduleConsoleComponent on the frontend). appliedChange/inverseChange
/// mirror the frontend's ScheduleChange shape ({ remove: string[], create:
/// BlockDraft[] }) so undo never needs a second representation of a change.
/// The latest row for a venue with inverseChange set and consumedAt null is
/// the currently-offered undo token.
model AssistantMessage {
  id            String          @id @default(uuid())
  venueId       String
  venue         Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User            @relation(fields: [ownerId], references: [id])
  sender        AssistantSender
  text          String          @db.Text
  appliedChange Json?
  inverseChange Json?
  consumedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@index([venueId, createdAt])
  @@index([ownerId, createdAt])
}

model PayoutMethod {
  id               String           @id @default(uuid())
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind             PayoutMethodKind
  accountHolder    String
  identifierMasked String
  bankName         String?
  details          Json?
  isDefault        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([ownerId])
}

model AuditLogEntry {
