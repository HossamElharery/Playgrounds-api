// Matchena API — Prisma schema
// Domain reference: PROJECT_BLUEPRINT.md §1-19. See MATCHENA_BACKEND.md for the full narrative.

// Default client for runtime (`require('@prisma/client')`).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Editor/TS copy. Cursor's language service often resolves `.prisma/client`
// to a stale User/Venue type. tsconfig paths maps `@prisma/client` here.
generator clientSrc {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, btree_gist]
}

// ============================================================
// Identity & RBAC
// ============================================================

enum UserRole {
  player
  owner
  staff
  admin
}

enum UserStatus {
  active
  suspended
  banned
}

model User {
  id                String        @id @default(uuid())
  phone             String?       @unique
  email             String?       @unique
  emailVerifiedAt   DateTime?
  username          String?       @unique
  passwordHash      String?
  /// Throw-away identity created by a squad invite link ("play as guest").
  /// Real User row so sockets, squads and voice work unchanged, but the
  /// AuthGuard confines it to the squad surface. Swept after 24h idle.
  isGuest           Boolean       @default(false)
  name              String
  avatarUrl         String?
  avatarConfig      Json?
  roles             UserRole[]    @default([player])
  status            UserStatus    @default(active)
  preferredLang     String        @default("ar")
  countryCode       String        @default("EG")
  country           CountryConfig @relation(fields: [countryCode], references: [code])
  /// Home area resolved from the player's device GPS. Admin-only in the UI.
  governorateId     String?
  governorate       Governorate?  @relation(fields: [governorateId], references: [id])
  districtId        String?
  district          District?     @relation(fields: [districtId], references: [id])
  locationLat       Float?
  locationLng       Float?
  locationUpdatedAt DateTime?
  bioEn             String?
  bioAr             String?
  reputation        Int           @default(0)
  reliabilityPct    Float         @default(100)
  coinsBalance      Int           @default(0)
  /// Prepaid EGP wallet in minor units (piasters). Player bookings, bundles,
  /// and memberships debit this — they never charge a PSP directly. Top-up
  /// is the only player flow that uses card / Vodafone / InstaPay / Fawry.
  walletBalance     Int           @default(0)
  streakCount       Int           @default(0)
  streakUpdatedAt   DateTime?
  // MATCHENA_ENGAGEMENT_ENGINE_BLUEPRINT.md §4.3 — burnable tokens (400 coins
  // each) that protect streakCount from resetting when a daily check-in is
  // missed. Consumed automatically by RewardsService.dailyCheckIn.
  streakFreezes     Int           @default(0)
  matchesPlayed     Int           @default(0)
  mvps              Int           @default(0)
  lastSeenAt        DateTime?
  /// friends | teammates | everyone | nobody
  messagePolicy     String        @default("everyone")
  lastSeenVisible   Boolean       @default(true)
  notificationPrefs Json?
  referralCode      String        @unique @default(uuid())
  referredById      String?
  referredBy        User?         @relation("Referrals", fields: [referredById], references: [id])
  referrals         User[]        @relation("Referrals")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refreshTokens             RefreshToken[]
  otpCodes                  OtpCode[]
  ownedVenues               Venue[]                   @relation("VenueOwner")
  approvedVenues            Venue[]                   @relation("VenueApprovedBy")
  bookings                  Booking[]
  splitShares               BookingSplitShare[]
  recurringSeries           RecurringBookingSeries[]
  venueReviews              VenueReview[]
  ratingsGiven              PlayerRating[]            @relation("PlayerRatingRater")
  ratingsReceived           PlayerRating[]            @relation("PlayerRatingRatee")
  friendshipsInitiated      Friendship[]              @relation("FriendshipRequester")
  friendshipsReceived       Friendship[]              @relation("FriendshipAddressee")
  matchPosts                MatchPost[]
  matchJoinRequests         MatchPostJoinRequest[]
  teamsCaptained            Team[]                    @relation("TeamCaptain")
  teamMemberships           TeamMember[]
  chatParticipants          ChatThreadParticipant[]
  chatMessages              ChatMessage[]
  notifications             Notification[]
  squadMemberships          SquadMember[]
  sentSquadInvites          SquadInvite[]             @relation("SquadInviteFrom")
  receivedSquadInvites      SquadInvite[]             @relation("SquadInviteTo")
  squadJoinRequestsMade     SquadJoinRequest[]        @relation("SquadJoinRequestFrom")
  squadJoinRequestsRes      SquadJoinRequest[]        @relation("SquadJoinRequestResolvedBy")
  squadInviteHoldsHeld      SquadInviteHold[]         @relation("SquadInviteHoldHolder")
  squadInviteHoldsFrom      SquadInviteHold[]         @relation("SquadInviteHoldFrom")
  coinLedger                CoinLedgerEntry[]
  walletLedger              WalletLedgerEntry[]
  walletWithdrawals         WalletWithdrawalRequest[] @relation("WalletWithdrawalUser")
  walletWithdrawalsResolved WalletWithdrawalRequest[] @relation("WalletWithdrawalResolvedBy")
  questProgress             UserQuestProgress[]
  badges                    UserBadge[]
  promoCodesCreated         PromoCode[]
  promoRedemptions          PromoRedemption[]
  pulseAvailability         PulseAvailability?
  pulseOpportunities        PulseOpportunity[]        @relation("PulseOpportunityOrganizer")
  pulseClaims               PulseClaim[]
  staffInvitesSent          StaffInvite[]             @relation("StaffInviteInvitedBy")
  staffInvitesReceived      StaffInvite[]             @relation("StaffInviteInvitee")
  roleAssignments           UserRoleAssignment[]
  ownedRoles                Role[]                    @relation("RoleOwner")
  reportsFiled              ModerationReport[]        @relation("ModerationReportReporter")
  reportsAgainstMe          ModerationReport[]        @relation("ModerationReportReportedUser")
  reportsReviewed           ModerationReport[]        @relation("ModerationReportReviewedBy")
  auditLogEntries           AuditLogEntry[]
  assistantMessages         AssistantMessage[]
  sportSkills               UserSportSkill[]
  blogPosts                 BlogPost[]
  supportInquiries          SupportInquiry[]
  deviceTokens              DeviceToken[]
  blocksMade                UserBlock[]               @relation("Blocker")
  blocksReceived            UserBlock[]               @relation("Blocked")
  favoriteVenues            FavoriteVenue[]
  matchComments             MatchPostComment[]
  matchReactions            MatchPostReaction[]
  partnerApplications       PartnerApplication[]
  partnerAppEvents          PartnerApplicationEvent[]
  payoutMethods             PayoutMethod[]
  calendarBlocksCreated     CalendarBlock[]
  createdBookings           Booking[]                 @relation("BookingCreatedBy")
  ledgerEntriesCreated      VenueLedgerEntry[]        @relation("LedgerCreatedBy")
  staffMember               StaffMember?              @relation("StaffMemberUser")
  staffTeam                 StaffMember[]             @relation("StaffMemberOwner")
  subscriptionPayments      SubscriptionPayment[]     @relation("SubscriptionPaymentRecordedBy")
  settlementsRecorded       VenueSettlement[]         @relation("SettlementRecordedBy")
  settlementsConfirmed      VenueSettlement[]         @relation("SettlementConfirmedBy")
  membership                UserMembership?
  tournamentEntries         TournamentParticipant[]
  oauthIdentities           OAuthIdentity[]
  webauthnCredentials       WebAuthnCredential[]
  teamMembershipRequests    TeamMembershipRequest[]   @relation("TeamRequestPlayer")
  teamRequestsSent          TeamMembershipRequest[]   @relation("TeamRequestSender")
  feedPosts                 Post[]                    @relation("PostAuthor")
  postsRemoved              Post[]                    @relation("PostRemovedBy")
  postComments              PostComment[]
  postLikes                 PostLike[]
  postSaves                 PostSave[]
  postShares                PostShare[]
  followsMade               Follow[]                  @relation("FollowFollower")
  followsReceived           Follow[]                  @relation("FollowFollowing")
  postReportsFiled          PostReport[]
  postReportsReviewed       PostReport[]              @relation("PostReportReviewedBy")
  moderationActionsTaken    ModerationAction[]        @relation("ModerationActionAdmin")
  postingRestriction        UserPostingRestriction?
  coinsRulesUpdated         CoinsRewardRule[]
  mediaAssets               MediaAsset[]
  /// Fake accounts created for a demo venue.
  isDemo                    Boolean                   @default(false)
  pushSubscriptions         PushSubscription[]

  @@index([isGuest, createdAt])
  @@index([status])
  @@index([countryCode])
  @@index([governorateId])
  @@index([districtId])
  @@index([username])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum OAuthProvider {
  google
  facebook
  apple
}

model OAuthIdentity {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// Platform authenticators (Face ID, Touch ID, Android fingerprint, Windows Hello).
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String[]  @default([])
  friendlyName String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String   @default("web") // web | ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model FavoriteVenue {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, venueId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum OtpPurpose {
  login
  register
  reset_password
  verify_phone
}

model OtpCode {
  id         String     @id @default(uuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  target     String // phone or email the code was sent to
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([target, purpose])
}

model Permission {
  id            String           @id @default(uuid())
  key           String           @unique // e.g. "bookings.checkin", "calendar.view"
  descriptionEn String?
  descriptionAr String?
  roles         RolePermission[]
}

model Role {
  id          String               @id @default(uuid())
  ownerId     String // the venue-owner account this staff role belongs to
  owner       User                 @relation("RoleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime             @default(now())
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([ownerId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId  String
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, venueId])
}

// ============================================================
// Geo / taxonomy
// ============================================================

model CountryConfig {
  code                 String        @id // ISO 3166-1 alpha-2, e.g. "EG"
  nameEn               String
  nameAr               String
  currency             String
  phoneCallingCode     String
  timezone             String        @default("Africa/Cairo") // IANA
  locale               String        @default("ar")
  weekendDays          Int[]         @default([5, 6]) // 0=Sun … 6=Sat
  paymentMethods       String[]
  serviceFeePct        Float         @default(5)
  coinsPerHundredMajor Int           @default(10)
  coinToMajorRate      Float         @default(20)
  lat                  Float?
  lng                  Float?
  active               Boolean       @default(true)
  governorates         Governorate[]
  users                User[]
  venues               Venue[]
}

model Governorate {
  id          String        @id @default(uuid())
  countryCode String
  country     CountryConfig @relation(fields: [countryCode], references: [code])
  slug        String?
  nameEn      String
  nameAr      String
  districts   District[]
  venues      Venue[]
  users       User[]

  @@unique([countryCode, slug])
  @@index([countryCode])
}

model District {
  id            String      @id @default(uuid())
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id])
  slug          String?
  nameEn        String
  nameAr        String
  lat           Float?
  lng           Float?
  polygon       Json?
  venues        Venue[]
  matchPosts    MatchPost[]
  users         User[]

  @@unique([governorateId, slug])
  @@index([governorateId])
}

model SportCategory {
  id           String   @id @default(uuid())
  slug         String   @unique
  nameEn       String
  nameAr       String
  icon         String
  accentColor  String?
  // 'field-sport' | 'racket-court' | 'gaming-station' | 'table-game'
  // Drives which UI affordances render (skill-tier chip, "players needed"
  // wording, mega-menu grouping). Nullable for backward compatibility with
  // any row created before this field existed.
  activityKind String?
  createdAt    DateTime @default(now())

  courts      Court[]
  matchPosts  MatchPost[]
  promoCodes  PromoCode[]
  userSkills  UserSportSkill[]
  pulseAvail  PulseAvailability[]
  pulseOpps   PulseOpportunity[]
  venueSports VenueSport[]
  teams       Team[]
}

enum SkillTier {
  bronze
  silver
  gold
  platinum
  legend
}

model UserSportSkill {
  id       String        @id @default(uuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportId  String
  sport    SportCategory @relation(fields: [sportId], references: [id], onDelete: Cascade)
  tier     SkillTier     @default(bronze)
  eloScore Int           @default(1000)
  position String?

  @@unique([userId, sportId])
}

model Amenity {
  id     String         @id @default(uuid())
  key    String         @unique
  nameEn String
  nameAr String
  icon   String
  venues VenueAmenity[]
}

// ============================================================
// Venues & booking core
// ============================================================

enum VenueStatus {
  pending
  active
  suspended
}

enum PartnerApplicationStatus {
  draft
  pending
  changes_requested
  approved
  rejected
  suspended
}

enum CalendarBlockKind {
  maintenance
  private
}

enum PayoutMethodKind {
  bank
  instapay
  wallet
}

model Venue {
  id                       String           @id @default(uuid())
  slug                     String           @unique
  ownerId                  String
  owner                    User             @relation("VenueOwner", fields: [ownerId], references: [id])
  countryCode              String           @default("EG")
  country                  CountryConfig    @relation(fields: [countryCode], references: [code])
  nameEn                   String
  nameAr                   String
  descriptionEn            String?          @db.Text
  descriptionAr            String?          @db.Text
  governorateId            String?
  governorate              Governorate?     @relation(fields: [governorateId], references: [id])
  districtId               String?
  district                 District?        @relation(fields: [districtId], references: [id])
  address                  String?
  lat                      Float
  lng                      Float
  geohash                  String
  surface                  String?
  instantBook              Boolean          @default(true)
  cancellationPolicy       String?          @db.Text
  weeklyHours              Json?
  contactPhone             String?
  legalBusinessName        String?
  registrationNumber       String?
  houseRules               String?          @db.Text
  status                   VenueStatus      @default(pending)
  featured                 Boolean          @default(false)
  paymentMode              VenuePaymentMode @default(at_venue)
  paymentModeChangedAt     DateTime?
  approvedById             String?
  approvedBy               User?            @relation("VenueApprovedBy", fields: [approvedById], references: [id])
  approvedAt               DateTime?
  ratingAvg                Float            @default(0)
  ratingCount              Int              @default(0)
  priceFromAmount          Int?
  priceFromCurrency        String?
  seoTitleOverrideAr       String?          @db.VarChar(60)
  seoTitleOverrideEn       String?          @db.VarChar(60)
  seoDescriptionOverrideAr String?          @db.VarChar(160)
  seoDescriptionOverrideEn String?          @db.VarChar(160)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  courts             Court[]
  photos             VenuePhoto[]
  amenities          VenueAmenity[]
  sports             VenueSport[]
  reviews            VenueReview[]
  bookings           Booking[]
  matchPosts         MatchPost[]
  promoCodes         PromoCode[]
  commissionSetting  CommissionSetting?
  payouts            Payout[]
  staffInvites       StaffInvite[]
  roleAssignments    UserRoleAssignment[]
  favorites          FavoriteVenue[]
  partnerApplication PartnerApplication?
  calendarBlocks     CalendarBlock[]
  bundles            Bundle[]
  tournaments        Tournament[]
  assistantMessages  AssistantMessage[]
  taggedPosts        Post[]
  ledgerEntries      VenueLedgerEntry[]
  settlements        VenueSettlement[]
  subscription       VenueSubscription?
  pricingDiscounts   PricingDiscount[]
  bookingSources     VenueBookingSource[]
  expenses           VenueExpense[]
  platformRequests   PlatformBookingRequest[]
  /// A sales-demo venue: never shown publicly and never counted in any real figure.
  isDemo             Boolean                  @default(false)

  @@index([geohash])
  @@index([lat, lng])
  @@index([status])
  @@index([countryCode, status])
  @@index([status, districtId])
  @@index([status, governorateId])
  @@index([status, geohash])
  @@index([status, ratingAvg])
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([nameAr(ops: raw("gin_trgm_ops"))], type: Gin)
}

model VenueSport {
  venueId String
  venue   Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sportId String
  sport   SportCategory @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([venueId, sportId])
}

model VenueAmenity {
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([venueId, amenityId])
}

model VenuePhoto {
  id       String @id @default(uuid())
  venueId  String
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url      String
  position Int    @default(0)

  @@index([venueId])
}

model Court {
  id               String        @id @default(uuid())
  venueId          String
  venue            Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sportId          String
  sport            SportCategory @relation(fields: [sportId], references: [id])
  name             String
  surface          String?
  indoor           Boolean       @default(false)
  format           String? // "5v5", "7v7"...
  slotDurationMins Int           @default(60)
  spec             Json?
  // Present only when sport.activityKind === 'gaming-station':
  // { consoleType: 'ps4'|'ps5'|'xbox-series'|'pc'|'vr'; seats: number; roomTier: 'standard'|'vip-big-screen'|'vr-booth'; gameIds?: string[] }
  gamingConfig     Json?
  // Present only when sport.activityKind === 'table-game':
  // { tableType?: 'american-8-ball'|'snooker'|'carom'; rentalAvailable: boolean; rentalPrice?: { amount: number; currency: string } }
  tableConfig      Json?
  // 'everyone' | 'teen' | 'mature' — informational badge only, not an enforced age-gate
  ageRating        String?
  createdAt        DateTime      @default(now())

  pricingRules   PricingRule[]
  discounts      PricingDiscount[]
  bookings       Booking[]
  recurring      RecurringBookingSeries[]
  matchPosts     MatchPost[]
  calendarBlocks CalendarBlock[]
  bundleItems    BundleItem[]

  @@index([venueId])
}

model PricingRule {
  id          String    @id @default(uuid())
  courtId     String
  court       Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  label       String // "base" | "peak" | "weekend" | custom
  daysOfWeek  Int[] // 0=Sun..6=Sat, empty = every day
  startTime   String // "18:00"
  endTime     String // "23:00"
  priceAmount Int // minor units (piasters)
  currency    String    @default("EGP")
  priority    Int       @default(0)
  /// `base` (the everyday price) or `discount` (time-boxed, created from an insight or by hand).
  kind        String    @default("base")
  /// `manual` | `suggestion`
  source      String    @default("manual")
  /// When set the rule only applies to slots that START inside [validFrom, validUntil).
  validFrom   DateTime?
  validUntil  DateTime?

  @@index([courtId])
}

enum BookingStatus {
  held
  confirmed
  cancelled
  completed
  no_show
}

enum PaymentMethod {
  card
  wallet
  apple_pay
  google_pay
  paypal
  cash
  vodafone
  orange
  etisalat
  fawry
  instapay
  mada
  stc_pay
  benefit
  knet
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partial
}

enum BookingSource {
  platform
  manual
}

enum VenuePaymentMode {
  at_venue
  online
}

enum LedgerEntryKind {
  booking_accrual
  booking_adjustment
  payout_to_owner
  remittance_from_owner
  manual_adjustment
}

enum SettlementDirection {
  platform_to_owner
  owner_to_platform
}

enum SettlementStatus {
  pending_confirmation
  confirmed
  rejected
}

model Booking {
  id                  String                  @id @default(uuid())
  code                String                  @unique // human-friendly booking code
  courtId             String
  court               Court                   @relation(fields: [courtId], references: [id])
  venueId             String
  venue               Venue                   @relation(fields: [venueId], references: [id])
  userId              String
  user                User                    @relation(fields: [userId], references: [id])
  slotStart           DateTime
  slotEnd             DateTime
  baseAmount          Int
  feeAmount           Int                     @default(0)
  discountAmount      Int                     @default(0)
  totalAmount         Int
  currency            String                  @default("EGP")
  promoCodeId         String?
  promoCode           PromoCode?              @relation(fields: [promoCodeId], references: [id])
  coinsRedeemed       Int                     @default(0)
  paymentMethod       PaymentMethod?
  paymentStatus       PaymentStatus           @default(pending)
  status              BookingStatus           @default(held)
  holdExpiresAt       DateTime?
  isSplitPayment      Boolean                 @default(false)
  qrPayload           String?                 @unique
  checkedInAt         DateTime?
  checkedInByUserId   String?
  cancelledAt         DateTime?
  cancellationReason  String?
  guestName           String?
  guestPhone          String?
  recurringSeriesId   String?
  recurringSeries     RecurringBookingSeries? @relation(fields: [recurringSeriesId], references: [id])
  // Matchena gaming expansion — MATCHENA_GAMING_EXPANSION_BLUEPRINT.md §3.7/§7.3.
  // Links the N linked Booking rows created atomically by a bundle purchase.
  bundleId            String?
  bundle              Bundle?                 @relation(fields: [bundleId], references: [id])
  // §3.8 — true when this booking's charge was covered by an active
  // membership's included hours instead of a real payment.
  membershipCovered   Boolean                 @default(false)
  source              BookingSource           @default(platform)
  sourceKey           String?
  sourceLabel         String?
  notes               String?                 @db.Text
  createdByUserId     String?
  createdByUser       User?                   @relation("BookingCreatedBy", fields: [createdByUserId], references: [id])
  paymentModeSnapshot VenuePaymentMode?
  ownerFundedDiscount Int                     @default(0)
  commissionBps       Int?
  commissionAmount    Int?
  ownerNetAmount      Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  splitShares         BookingSplitShare[]
  payments            Payment[]
  ledgerEntries       VenueLedgerEntry[]
  reviews             VenueReview[]
  ratings             PlayerRating[]
  promoRedemptions    PromoRedemption[]
  coinLedgerEntries   CoinLedgerEntry[]
  walletLedgerEntries WalletLedgerEntry[]
  pulseOpportunity    PulseOpportunity?
  pulseClaims         PulseClaim[]
  // Live-slot uniqueness is a partial unique index (courtId, slotStart) plus a
  // GiST EXCLUDE on trigger-maintained slotRange. Prisma cannot declare either;
  // see prisma/migrations/20260904031300_booking_slot_uniqueness and
  // prisma/migrations/20260905090000_booking_slot_range_exclude.
  platformRequests    PlatformBookingRequest[]

  @@index([courtId, slotStart])
  @@index([userId])
  @@index([status])
  @@index([venueId, slotStart])
  @@index([venueId, status])
  @@index([venueId, source, slotStart])
  @@index([venueId, status, slotStart])
}

enum SplitShareStatus {
  pending
  paid
  released
}

model BookingSplitShare {
  id             String           @id @default(uuid())
  bookingId      String
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  phone          String?
  amount         Int
  currency       String           @default("EGP")
  status         SplitShareStatus @default(pending)
  shareLinkToken String           @unique @default(uuid())
  createdAt      DateTime         @default(now())

  @@index([bookingId])
}

model Payment {
  id          String        @id @default(uuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Int
  currency    String        @default("EGP")
  method      PaymentMethod
  status      PaymentStatus @default(pending)
  providerRef String?
  createdAt   DateTime      @default(now())

  @@index([bookingId])
}

/// An owner's request to change or cancel a booking that came from Matchena. The owner cannot do it
/// themselves (the player was promised the slot and money may be refunded), so an admin decides here.
model PlatformBookingRequest {
  id           String    @id @default(uuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  venueId      String
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// cancel | change
  kind         String
  reason       String
  /// open | approved | declined | answered | closed
  status       String    @default("open")
  adminReply   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([venueId, status])
  @@index([status, createdAt])
  @@index([bookingId])
}

/// A cost the owner records so the dashboard can show real profit (revenue − commission − expenses).
/// Amounts are minor units; `incurredOn` is the venue-LOCAL calendar date (YYYY-MM-DD).
model VenueExpense {
  id                String         @id @default(uuid())
  venueId           String
  venue             Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// electricity | water | rent | salaries | maintenance | marketing | supplies | other
  category          String
  /// Free text when category = other.
  categoryLabel     String?
  amount            Int
  currency          String         @default("EGP")
  incurredOn        String
  note              String?
  /// A template row repeats every month on the same day until `recurringUntil` (inclusive month).
  recurringMonthly  Boolean        @default(false)
  recurringUntil    String?
  /// Set on the monthly copies generated from a template; each copy can be edited on its own.
  recurringParentId String?
  recurringParent   VenueExpense?  @relation("ExpenseRecurrence", fields: [recurringParentId], references: [id], onDelete: SetNull)
  children          VenueExpense[] @relation("ExpenseRecurrence")
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt

  @@unique([recurringParentId, incurredOn])
  @@index([venueId, incurredOn])
}

model RecurringBookingSeries {
  id           String   @id @default(uuid())
  courtId      String
  court        Court    @relation(fields: [courtId], references: [id])
  /// Player-owned series have a user; owner "fixed bookings" have none (customer is name/phone).
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  dayOfWeek    Int
  startTime    String
  durationMins Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // ---- owner fixed bookings (source = manual) ----
  venueId         String?
  /// `player` (legacy) | `manual`
  kind            String   @default("player")
  customerName    String?
  customerPhone   String?
  /// `per_session` | `prepaid`
  paymentPlan     String   @default("per_session")
  /// Manual price for every session in minor units; null = quote each session.
  priceAmount     Int?
  /// Local (venue timezone) date of the first session, YYYY-MM-DD.
  startDate       String?
  /// Last local date a session may fall on (inclusive); null = open-ended.
  until           String?
  /// active | ended
  status          String   @default("active")
  /// Local dates the owner removed; the horizon job never regenerates them.
  skippedDates    String[] @default([])
  /// Local dates already reported as conflicting, so the owner is told once.
  conflictDates   String[] @default([])
  sourceKey       String?
  sourceLabel     String?
  notes           String?  @db.Text
  createdByUserId String?
  updatedAt       DateTime @default(now()) @updatedAt

  bookings Booking[]

  @@index([userId])
  @@index([venueId, status])
}

// ============================================================
// Reviews & ratings
// ============================================================

model VenueReview {
  id             String    @id @default(uuid())
  venueId        String
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  stars          Int
  tags           String[]
  text           String?   @db.Text
  photos         String[]
  ownerReply     String?   @db.Text
  ownerRepliedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([bookingId, userId])
  @@index([venueId])
}

model PlayerRating {
  id            String     @id @default(uuid())
  bookingId     String?
  booking       Booking?   @relation(fields: [bookingId], references: [id])
  matchPostId   String?
  matchPost     MatchPost? @relation(fields: [matchPostId], references: [id])
  raterId       String
  rater         User       @relation("PlayerRatingRater", fields: [raterId], references: [id])
  rateeId       String
  ratee         User       @relation("PlayerRatingRatee", fields: [rateeId], references: [id])
  sportsmanship Int
  skill         Int
  punctuality   Int
  mvpVote       Boolean    @default(false)
  createdAt     DateTime   @default(now())

  // Postgres allows multiple NULLs through a unique index, so these only bite
  // on the path they actually apply to (bookingId is null for matchPost
  // ratings and vice versa) — exactly what's needed to stop the same rater
  // rating the same person on the same match/booking more than once to farm
  // the 10-coin reward repeatedly.
  @@unique([bookingId, raterId, rateeId])
  @@unique([matchPostId, raterId, rateeId])
  @@index([rateeId])
}

// ============================================================
// Social
// ============================================================

enum FriendshipStatus {
  pending
  accepted
  declined
  blocked
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

enum MatchPostStatus {
  open
  full
  played
  expired
  cancelled
}

model MatchPost {
  id                  String            @id @default(uuid())
  authorId            String
  author              User              @relation(fields: [authorId], references: [id])
  sportId             String
  sport               SportCategory     @relation(fields: [sportId], references: [id])
  venueId             String?
  venue               Venue?            @relation(fields: [venueId], references: [id])
  courtId             String?
  court               Court?            @relation(fields: [courtId], references: [id])
  districtId          String?
  district            District?         @relation(fields: [districtId], references: [id])
  dateTime            DateTime
  playersNeeded       Int
  skillTier           SkillTier?
  costPerPlayerAmount Int?
  currency            String            @default("EGP")
  notes               String?           @db.Text
  chatThreadId        String?           @unique
  chatThread          ChatThread?       @relation(fields: [chatThreadId], references: [id])
  status              MatchPostStatus   @default(open)
  // Matchena gaming expansion — MATCHENA_GAMING_EXPANSION_BLUEPRINT.md §3.6/§3.10.
  // Only meaningful when sport.activityKind === 'gaming-station'.
  gameId              String?
  game                GameCatalogEntry? @relation(fields: [gameId], references: [id])
  // 'match' | 'watch-party' — defaults to 'match'.
  kind                String            @default("match")
  createdAt           DateTime          @default(now())

  joinRequests       MatchPostJoinRequest[]
  pulseOpportunities PulseOpportunity[]
  comments           MatchPostComment[]
  reactions          MatchPostReaction[]
  playerRatings      PlayerRating[]
  tournamentMatches  TournamentMatch[]
  linkedPosts        Post[]

  @@index([sportId, status])
  @@index([districtId])
  @@index([dateTime, status])
}

model MatchPostComment {
  id          String    @id @default(uuid())
  matchPostId String
  matchPost   MatchPost @relation(fields: [matchPostId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  text        String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([matchPostId, createdAt])
}

model MatchPostReaction {
  id          String    @id @default(uuid())
  matchPostId String
  matchPost   MatchPost @relation(fields: [matchPostId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji       String    @default("like")
  createdAt   DateTime  @default(now())

  @@unique([matchPostId, userId, emoji])
}

enum JoinRequestStatus {
  pending
  approved
  declined
}

model MatchPostJoinRequest {
  id          String            @id @default(uuid())
  matchPostId String
  matchPost   MatchPost         @relation(fields: [matchPostId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  status      JoinRequestStatus @default(pending)
  createdAt   DateTime          @default(now())

  @@unique([matchPostId, userId])
}

model Team {
  id           String         @id @default(uuid())
  name         String
  logoUrl      String?
  captainId    String
  captain      User           @relation("TeamCaptain", fields: [captainId], references: [id])
  sportId      String?
  sport        SportCategory? @relation(fields: [sportId], references: [id])
  chatThreadId String?        @unique
  chatThread   ChatThread?    @relation(fields: [chatThreadId], references: [id])
  createdAt    DateTime       @default(now())
  archivedAt   DateTime?

  members            TeamMember[]
  challengesMade     TeamChallenge[]         @relation("TeamChallengeChallenger")
  challengesReceived TeamChallenge[]         @relation("TeamChallengeChallenged")
  membershipRequests TeamMembershipRequest[]
}

model TeamMembershipRequest {
  id            String    @id @default(uuid())
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation("TeamRequestPlayer", fields: [userId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation("TeamRequestSender", fields: [requestedById], references: [id], onDelete: Cascade)
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  @@index([teamId, status])
  @@index([userId, status])
}

model TeamMember {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
}

enum ChallengeStatus {
  pending
  accepted
  declined
  played
}

model TeamChallenge {
  id               String          @id @default(uuid())
  challengerTeamId String
  challengerTeam   Team            @relation("TeamChallengeChallenger", fields: [challengerTeamId], references: [id])
  challengedTeamId String
  challengedTeam   Team            @relation("TeamChallengeChallenged", fields: [challengedTeamId], references: [id])
  status           ChallengeStatus @default(pending)
  proposedDateTime DateTime?
  createdAt        DateTime        @default(now())
}

enum ChatThreadType {
  direct
  match
  team
}

model ChatThread {
  id        String         @id @default(uuid())
  type      ChatThreadType
  title     String?
  pairKey   String?        @unique // canonical "userIdA:userIdB" for direct find-or-create
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  participants ChatThreadParticipant[]
  messages     ChatMessage[]
  matchPost    MatchPost?
  team         Team?

  @@index([type])
}

model ChatThreadParticipant {
  threadId          String
  thread            ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessageId String?
  joinedAt          DateTime   @default(now())

  @@id([threadId, userId])
}

enum MessageType {
  text
  image
  voice
  system
}

enum MessageDelivery {
  sent
  delivered
  read
}

model ChatMessage {
  id                   String          @id @default(uuid())
  threadId             String
  thread               ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  clientMessageId      String?
  senderId             String
  sender               User            @relation(fields: [senderId], references: [id])
  type                 MessageType     @default(text)
  text                 String?         @db.Text
  attachmentUrl        String?
  attachmentMime       String?
  attachmentSize       Int?
  attachmentDurationMs Int?
  delivery             MessageDelivery @default(sent)
  createdAt            DateTime        @default(now())
  editedAt             DateTime?
  deletedAt            DateTime?

  @@unique([threadId, clientMessageId])
  @@index([threadId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  titleEn   String
  titleAr   String
  bodyEn    String?
  bodyAr    String?
  deepLink  String?
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ---- Squad (§13) ----

model Squad {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  members      SquadMember[]
  invites      SquadInvite[]
  joinRequests SquadJoinRequest[]
  inviteLink   SquadInviteLink?
}

/// One shareable private link per squad. The public token is
/// `<id>.<hmac(id)>` so it can be re-shown to members without storing a
/// secret; revoking deletes the row (the old link stops resolving at once).
model SquadInviteLink {
  id          String   @id @default(uuid())
  squadId     String   @unique
  squad       Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  createdById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

model SquadMember {
  id       String   @id @default(uuid())
  squadId  String
  squad    Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  isLeader Boolean  @default(false)
  micMuted Boolean  @default(false)
  joinedAt DateTime @default(now())

  @@unique([squadId, userId])
}

enum SquadInviteStatus {
  pending
  accepted
  declined
  expired
}

model SquadInvite {
  id         String            @id @default(uuid())
  squadId    String
  squad      Squad             @relation(fields: [squadId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User              @relation("SquadInviteFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User              @relation("SquadInviteTo", fields: [toUserId], references: [id])
  status     SquadInviteStatus @default(pending)
  createdAt  DateTime          @default(now())
}

model SquadJoinRequest {
  id               String            @id @default(uuid())
  squadId          String
  squad            Squad             @relation(fields: [squadId], references: [id], onDelete: Cascade)
  fromUserId       String
  fromUser         User              @relation("SquadJoinRequestFrom", fields: [fromUserId], references: [id])
  viaMemberId      String?
  status           SquadInviteStatus @default(pending)
  resolvedByUserId String?
  resolvedByUser   User?             @relation("SquadJoinRequestResolvedBy", fields: [resolvedByUserId], references: [id])
  createdAt        DateTime          @default(now())
}

/// Receiver-side pause: after declining with "quiet for 5 min", the sender
/// cannot invite this holder again until `until`. Unique per pair so a later
/// quiet replaces an earlier one instead of stacking rows.
model SquadInviteHold {
  id         String   @id @default(uuid())
  holderId   String
  holder     User     @relation("SquadInviteHoldHolder", fields: [holderId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("SquadInviteHoldFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  until      DateTime
  createdAt  DateTime @default(now())

  @@unique([holderId, fromUserId])
  @@index([fromUserId, until])
}

// ============================================================
// Rewards economy
// ============================================================

model CoinLedgerEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // positive=earn, negative=burn
  reason    String
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Prepaid EGP wallet movements (piasters). Positive = top-up / refund credit,
/// negative = booking / membership / bundle debit.
model WalletLedgerEntry {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  method      PaymentMethod?
  bookingId   String?
  booking     Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  providerRef String?
  createdAt   DateTime       @default(now())

  @@index([userId, createdAt])
}

enum WalletWithdrawalStatus {
  pending
  paid
  rejected
}

/// A player's cash-out request. The wallet is debited the moment the request
/// is filed — reserving the funds so they can't be spent twice while an admin
/// reviews it — and refunded back if the request is rejected. There is no
/// automated payout provider wired up yet, so `paid` is set manually once the
/// transfer has actually happened outside the app.
model WalletWithdrawalRequest {
  id               String                 @id @default(uuid())
  userId           String
  user             User                   @relation("WalletWithdrawalUser", fields: [userId], references: [id], onDelete: Cascade)
  amount           Int
  currency         String                 @default("EGP")
  destination      String
  status           WalletWithdrawalStatus @default(pending)
  note             String?
  resolvedByUserId String?
  resolvedBy       User?                  @relation("WalletWithdrawalResolvedBy", fields: [resolvedByUserId], references: [id])
  createdAt        DateTime               @default(now())
  resolvedAt       DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Quest {
  id          String   @id @default(uuid())
  key         String   @unique
  titleEn     String
  titleAr     String
  rule        Json
  rewardCoins Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  progress UserQuestProgress[]
}

model UserQuestProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  target      Int
  completedAt DateTime?
  weekKey     String // ISO week for weekly quests

  @@unique([userId, questId, weekKey])
}

model Badge {
  id            String  @id @default(uuid())
  key           String  @unique
  nameEn        String
  nameAr        String
  icon          String
  iconKey       String?
  descriptionEn String?
  descriptionAr String?

  users UserBadge[]
}

model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

enum PromoType {
  percentage
  fixed_amount
}

model PromoCode {
  id                 String         @id @default(uuid())
  code               String         @unique
  type               PromoType
  value              Int // percentage points OR minor-unit amount depending on type
  currency           String         @default("EGP")
  sportId            String?
  sport              SportCategory? @relation(fields: [sportId], references: [id])
  venueId            String?
  venue              Venue?         @relation(fields: [venueId], references: [id])
  firstBookingOnly   Boolean        @default(false)
  offPeakOnly        Boolean        @default(false)
  minBookingAmount   Int?
  usageLimitTotal    Int?
  usageLimitPerUser  Int            @default(1)
  stackableWithCoins Boolean        @default(true)
  active             Boolean        @default(true)
  validFrom          DateTime
  validUntil         DateTime
  createdById        String?
  createdBy          User?          @relation(fields: [createdById], references: [id])
  createdAt          DateTime       @default(now())

  bookings    Booking[]
  redemptions PromoRedemption[]

  @@index([code])
}

model PromoRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  bookingId   String?
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([promoCodeId, userId])
}

// ============================================================
// Pulse / Rescue Match (§19)
// ============================================================

enum PulseWindow {
  now
  tonight
  weekend
}

enum PulseMode {
  casual
  competitive
}

model PulseAvailability {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  window          PulseWindow
  sportId         String
  sport           SportCategory @relation(fields: [sportId], references: [id])
  mode            PulseMode
  radiusKm        Float
  maxBudgetAmount Int
  currency        String        @default("EGP")
  districtId      String?
  startsAt        DateTime
  expiresAt       DateTime
  status          String        @default("active") // active|expired|cancelled
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
}

enum PulseOpportunityKind {
  rescue
  micro_lobby
  friend_ready
  venue_drop
}

enum PulseOpportunityStatus {
  open
  held
  claimed
  full
  expired
  cancelled
}

model PulseOpportunity {
  id                          String                 @id @default(uuid())
  kind                        PulseOpportunityKind
  status                      PulseOpportunityStatus @default(open)
  sportId                     String
  sport                       SportCategory          @relation(fields: [sportId], references: [id])
  mode                        PulseMode
  skillTier                   SkillTier?
  organizerUserId             String?
  organizer                   User?                  @relation("PulseOpportunityOrganizer", fields: [organizerUserId], references: [id])
  matchPostId                 String?
  matchPost                   MatchPost?             @relation(fields: [matchPostId], references: [id])
  bookingId                   String?                @unique
  booking                     Booking?               @relation(fields: [bookingId], references: [id])
  districtId                  String?
  startsAt                    DateTime
  expiresAt                   DateTime
  costPerPlayerAmount         Int
  originalCostPerPlayerAmount Int?
