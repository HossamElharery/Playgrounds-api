}

// ============================================================
// Matchena gaming expansion — see MATCHENA_GAMING_EXPANSION_BLUEPRINT.md
// §3.6-3.9, §7.3-7.4. Game catalog, multi-activity bundles, paid
// membership, lightweight esports tournaments.
// ============================================================

model GameCatalogEntry {
  id                      String   @id @default(uuid())
  slug                    String   @unique
  nameEn                  String
  nameAr                  String
  iconUrl                 String?
  genre                   String // sports | shooter | racing | fighting | other
  supportsCompetitiveTier Boolean  @default(true)
  ageRating               String   @default("everyone") // everyone | teen | mature
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())

  matchPosts MatchPost[]
}

model Bundle {
  id              String   @id @default(uuid())
  venueId         String
  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  nameEn          String
  nameAr          String
  discountPercent Int // applied to the combined base price of all items
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items    BundleItem[]
  bookings Booking[]

  @@index([venueId])
}

model BundleItem {
  id            String @id @default(uuid())
  bundleId      String
  bundle        Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  courtId       String
  court         Court  @relation(fields: [courtId], references: [id])
  durationUnits Int    @default(1)

  @@index([bundleId])
}

model MembershipPlan {
  id                     String   @id @default(uuid())
  slug                   String   @unique
  nameEn                 String
  nameAr                 String
  scope                  String // gaming | all-activities
  priceAmount            Int
  priceCurrency          String   @default("EGP")
  includedHours          Int
  overageDiscountPercent Int      @default(0)
  perksEn                String[] @default([])
  perksAr                String[] @default([])
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  memberships UserMembership[]
}

model UserMembership {
  id                  String         @id @default(uuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId              String
  plan                MembershipPlan @relation(fields: [planId], references: [id])
  status              String         @default("active") // active | past_due | cancelled
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  hoursUsedThisPeriod Float          @default(0)
  // §7.6 — the mock/manual-renewal path: real recurring billing needs a
  // PSP subscription object as source of truth (see payments module TODO).
  cancelledAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Tournament {
  id                   String   @id @default(uuid())
  venueId              String?
  venue                Venue?   @relation(fields: [venueId], references: [id])
  activityId           String // a SportCategory id or GameCatalogEntry id
  nameEn               String
  nameAr               String
  format               String   @default("single-elimination")
  entryFeeAmount       Int?
  entryFeeCurrency     String?
  maxParticipants      Int // 8 | 16 | 32
  registrationDeadline DateTime
  startsAt             DateTime
  status               String   @default("open") // open | full | in-progress | completed | cancelled
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  participants TournamentParticipant[]
  matches      TournamentMatch[]

  @@index([activityId, status])
  @@index([status, registrationDeadline])
}

model TournamentParticipant {
  id            String        @id @default(uuid())
  tournamentId  String
  tournament    Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seed          Int?
  registeredAt  DateTime      @default(now())
  entryFeePaid  Int           @default(0)
  paymentStatus PaymentStatus @default(paid)

  @@unique([tournamentId, userId])
}

model TournamentMatch {
  id                 String     @id @default(uuid())
  tournamentId       String
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round              Int
  // Stable position within its round (0-based) — winner of matchIndex i in
  // round r feeds slotA (if i even) / slotB (if i odd) of match
  // floor(i/2) in round r+1. Avoids relying on createdAt ordering.
  matchIndex         Int        @default(0)
  slotAId            String?
  slotBId            String?
  winnerId           String?
  scheduledAt        DateTime?
  matchPostId        String?
  matchPost          MatchPost? @relation(fields: [matchPostId], references: [id])
  resultConfirmedByA Boolean    @default(false)
  resultConfirmedByB Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([tournamentId, round, matchIndex])
  @@index([tournamentId, round])
}

// ============================================================
// Posts & media feed — see POSTS_FEED_MODULE_BLUEPRINT.md
// Separate from MatchPost. Public-only in v1.
// ============================================================

enum PostAuthorKind {
  user
  official
  venue
}

enum PostStatus {
  active
  removed
}

enum PostMediaType {
  image
  video
}

enum PostReportReason {
  spam
  inappropriate
  copyright
  harassment
  misinformation
  other
}

enum PostReportStatus {
  open
  reviewed
  dismissed
}

enum ModerationActionType {
  post_deleted
  comment_deleted
  user_posting_suspended
  user_posting_unsuspended
  report_dismissed
}

enum MediaAssetStatus {
  pending
  ready
  failed
}

model MediaAsset {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            PostMediaType
  key             String
  url             String
  thumbnailUrl    String?
  mimeType        String
  width           Int              @default(0)
  height          Int              @default(0)
  durationSeconds Int?
  altText         String?
  status          MediaAssetStatus @default(pending)
  createdAt       DateTime         @default(now())
  postMedia       PostMedia[]

  @@index([userId, createdAt])
}

model Post {
  id               String         @id @default(uuid())
  slug             String
  authorId         String
  author           User           @relation("PostAuthor", fields: [authorId], references: [id])
  authorKind       PostAuthorKind @default(user)
  text             String         @db.Text
  hashtags         String[]       @default([])
  mentions         String[]       @default([])
  taggedVenueId    String?
  taggedVenue      Venue?         @relation(fields: [taggedVenueId], references: [id])
  linkedMatchId    String?
  linkedMatch      MatchPost?     @relation(fields: [linkedMatchId], references: [id])
  visibility       String         @default("public")
  status           PostStatus     @default(active)
  autoHidden       Boolean        @default(false)
  flagged          Boolean        @default(false)
  removedReason    String?
  removedByAdminId String?
  removedByAdmin   User?          @relation("PostRemovedBy", fields: [removedByAdminId], references: [id])
  likeCount        Int            @default(0)
  commentCount     Int            @default(0)
  shareCount       Int            @default(0)
  saveCount        Int            @default(0)
  coinsAwarded     Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  media    PostMedia[]
  comments PostComment[]
  likes    PostLike[]
  saves    PostSave[]
  shares   PostShare[]
  reports  PostReport[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([taggedVenueId, createdAt])
  @@index([linkedMatchId])
  @@index([hashtags], type: Gin)
  @@index([slug])
}

model PostMedia {
  id              String        @id @default(uuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           MediaAsset?   @relation(fields: [assetId], references: [id])
  type            PostMediaType
  url             String
  thumbnailUrl    String
  width           Int
  height          Int
  durationSeconds Int?
  order           Int           @default(0)
  altText         String?

  @@index([postId, order])
}

model PostComment {
  id              String        @id @default(uuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation(fields: [authorId], references: [id])
  parentCommentId String?
  parent          PostComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         PostComment[] @relation("CommentReplies")
  text            String        @db.Text
  mentions        String[]      @default([])
  status          PostStatus    @default(active)
  removedReason   String?
  createdAt       DateTime      @default(now())

  @@index([postId, createdAt])
  @@index([parentCommentId])
}

model PostLike {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model PostSave {
