enum PublishStatus {
  draft
  published
  archived
}

model BlogCategory {
  id     String     @id @default(uuid())
  nameEn String
  nameAr String
  posts  BlogPost[]
}

model BlogPost {
  id            String        @id @default(uuid())
  slug          String        @unique
  titleEn       String
  titleAr       String
  subtitleEn    String?
  subtitleAr    String?
  coverImageUrl String?
  contentEn     String        @db.Text
  contentAr     String        @db.Text
  categoryId    String?
  category      BlogCategory? @relation(fields: [categoryId], references: [id])
  authorId      String?
  author        User?         @relation(fields: [authorId], references: [id])
  status        PublishStatus @default(draft)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  /// Optional in-article call-to-action (e.g. "Book a padel court" -> /en/explore?sport=padel).
  /// Admin-set; the frontend falls back to a generic "Book now" -> /explore when unset.
  ctaLabelEn String?
  ctaLabelAr String?
  ctaHref    String?

  /// Tags this post to one sport slug (e.g. "padel") so the sport-hub page can surface it
  /// in a "From the Journal" section, and so the article's default CTA can deep-link back.
  relatedSportSlug String?

  /// Optional SEO overrides. When empty the frontend falls back to title / subtitle.
  seoTitleEn       String?
  seoTitleAr       String?
  seoDescriptionEn String?
  seoDescriptionAr String?
  /// Comma-separated topic keywords — emitted as Article.keywords in JSON-LD (not meta keywords).
  keywordsEn       String?
  keywordsAr       String?

  @@index([status])
  @@index([relatedSportSlug])
}

model Banner {
  id        String   @id @default(uuid())
  titleEn   String
  titleAr   String
  imageUrl  String
  linkUrl   String?
  placement String // "home_hero" | "explore_top" ...
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FaqEntry {
  id         String @id @default(uuid())
  questionEn String
  questionAr String
  answerEn   String @db.Text
  answerAr   String @db.Text
  position   Int    @default(0)
}

model SupportInquiry {
  id        String    @id @default(uuid())
  fullName  String
  email     String
  phone     String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  message   String    @db.Text
  status    String    @default("new") // new|read
  createdAt DateTime  @default(now())
  readAt    DateTime?
}

