model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String
  userId    String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

/// A staff login created by a venue owner / manager (or the platform admin).
/// Dashboard access for `staff` users comes ONLY from this row: which venues they
/// may work on and exactly which permission keys they hold.
model StaffMember {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation("StaffMemberUser", fields: [userId], references: [id])
  /// The venue owner (organisation) this person works for.
  ownerId     String
  owner       User     @relation("StaffMemberOwner", fields: [ownerId], references: [id])
  /// Free-text job title shown in the team list, e.g. "Reception".
  title       String?
  permissions String[]
  venueIds    String[]
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

/// One manual subscription per venue. Nothing here blocks the venue: it drives the
/// owner's "your plan" card, the daily reminders and the admin's renewals list.
model VenueSubscription {
  id                String   @id @default(uuid())
  venueId           String   @unique
  venue             Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  planKey           String   @default("pro")
  /// Public list price (minor units) — shown struck through to the owner.
  listPriceAmount   Int      @default(300000)
  /// What was actually agreed. Admin-only, never sent to the owner.
  agreedPriceAmount Int?
  currency          String   @default("EGP")
  startedAt         DateTime @default(now())
  currentPeriodEnd  DateTime
  graceDays         Int      @default(14)
  notes             String?  @db.Text
  /// venue-local yyyy-mm-dd of the last reminder, so the morning job runs once a day.
  lastNoticeDate    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments SubscriptionPayment[]

  @@index([currentPeriodEnd])
}

model SubscriptionPayment {
  id              String            @id @default(uuid())
  subscriptionId  String
  subscription    VenueSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  venueId         String
  /// Minor units received; 0 for a free extension.
  amount          Int               @default(0)
  currency        String            @default("EGP")
  method          String?
  daysAdded       Int
  periodEndBefore DateTime
  periodEndAfter  DateTime
  paidAt          DateTime          @default(now())
  note            String?           @db.Text
  recordedById    String
  recordedBy      User              @relation("SubscriptionPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([venueId, paidAt])
}

/// A discount on an idle window (one court, one weekday, some hours) — applied from a suggestion
/// or by hand, or a suggestion the owner dismissed. The price change itself lives in `PricingRule`
/// rows (`ruleIds`); this row remembers why, and what occupancy was before, so the result can be measured.
model PricingDiscount {
  id                   String    @id @default(uuid())
  venueId              String
  venue                Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  courtId              String
  court                Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday, venue-local
  weekday              Int
  startHour            Int
  endHour              Int
  percent              Int       @default(0)
  /// active | ended | dismissed
  status               String    @default("active")
  /// suggestion | manual
  source               String    @default("manual")
  validFrom            DateTime?
  validUntil           DateTime?
  /// Occupancy of the window (0..1) when the discount was applied.
  baselineOccupancy    Float?
  estimatedMonthlyLoss Int?
  ruleIds              String[]
  /// A dismissed suggestion stays hidden until then.
  dismissedUntil       DateTime?
  endedAt              DateTime?
  createdById          String
  createdAt            DateTime  @default(now())

  @@index([venueId, status])
  @@index([courtId, weekday])
}
